@model RegisterUserDto
@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}
<div class="max-w-xl mx-auto">
    <div class="text-center mb-8">
        <div class="w-14 h-14 rounded-full bg-surface-container flex items-center justify-center text-primary-container mx-auto mb-4">
            <span class="material-symbols-outlined">person_add</span>
        </div>
        <h1 class="font-headline-lg text-headline-lg text-primary-container">Kayıt Ol</h1>
        <p class="text-on-surface-variant">Hesap oluşturun, gönderdiğiniz ve size gelen kargoları takip edin.</p>
    </div>
    <form method="post" class="bg-white rounded-xl shadow-sm border border-outline-variant p-6 md:p-8">
        <div asp-validation-summary="ModelOnly" class="text-error text-sm mb-4"></div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div>
            <label class="block text-sm font-semibold text-on-surface-variant mb-1">Ad</label>
            <input asp-for="FirstName" type="text" class="w-full border border-outline-variant rounded-lg px-3 py-3 focus:border-primary focus:ring-1 focus:ring-primary" />
            <span asp-validation-for="FirstName" class="text-error text-xs"></span>
        </div>
        <div>
            <label class="block text-sm font-semibold text-on-surface-variant mb-1">Soyad</label>
            <input asp-for="LastName" type="text" class="w-full border border-outline-variant rounded-lg px-3 py-3 focus:border-primary focus:ring-1 focus:ring-primary" />
            <span asp-validation-for="LastName" class="text-error text-xs"></span>
        </div>
        </div>
        <div class="grid grid-cols-1 gap-4 mb-4">
        <div>
            <label class="block text-sm font-semibold text-on-surface-variant mb-1">E-posta</label>
            <input asp-for="Email" type="email" class="w-full border border-outline-variant rounded-lg px-3 py-3 focus:border-primary focus:ring-1 focus:ring-primary" />
            <span asp-validation-for="Email" class="text-error text-xs"></span>
        </div>
        <div>
            <label class="block text-sm font-semibold text-on-surface-variant mb-1">Kullanıcı Adı</label>
            <input asp-for="UserName" type="text" class="w-full border border-outline-variant rounded-lg px-3 py-3 focus:border-primary focus:ring-1 focus:ring-primary" />
            <span asp-validation-for="UserName" class="text-error text-xs"></span>
        </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div>
            <label class="block text-sm font-semibold text-on-surface-variant mb-1">Şifre</label>
            <input asp-for="Password" type="password" class="w-full border border-outline-variant rounded-lg px-3 py-3 focus:border-primary focus:ring-1 focus:ring-primary" />
            <span asp-validation-for="Password" class="text-error text-xs"></span>
        </div>
        <div>
            <label class="block text-sm font-semibold text-on-surface-variant mb-1">Şifre Tekrarı</label>
            <input asp-for="ConfirmPassword" type="password" class="w-full border border-outline-variant rounded-lg px-3 py-3 focus:border-primary focus:ring-1 focus:ring-primary" />
            <span asp-validation-for="ConfirmPassword" class="text-error text-xs"></span>
        </div>
        </div>
        <button class="w-full bg-secondary-container text-white py-3 rounded-lg font-semibold hover:opacity-90">Kayıt Ol</button>
        <p class="text-center text-sm text-on-surface-variant mt-6">
            Zaten hesabınız var mı? <a href="/Login/Index" class="text-primary-container font-bold hover:underline">Giriş yapın</a>
        </p>
    </form>
</div>
