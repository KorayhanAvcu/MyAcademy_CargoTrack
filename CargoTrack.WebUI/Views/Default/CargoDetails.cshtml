@using CargoTrack.Entity.Entities
@model Cargo
@{
    ViewData["Title"] = "CargoDetails";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-8 gap-4">
    <div>
        <h1 class="font-headline-lg text-headline-lg text-primary-container mb-2">Gönderi Detayları</h1>
        <p class="text-on-surface-variant font-body-md">Gönderinizin güncel durumunu ve hareket geçmişini inceleyin.</p>
    </div>
    <div class="flex gap-3 w-full md:w-auto">
        <button class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-surface-container-high text-primary-container border border-primary-container/20 px-4 py-2.5 rounded-lg font-semibold hover:bg-surface-container-highest transition-colors">
            <span class="material-symbols-outlined">print</span>
            Kargo Detayını Yazdır
        </button>
        <button class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-secondary-container text-on-secondary px-6 py-2.5 rounded-lg font-semibold hover:bg-opacity-90 transition-colors shadow-sm">
            <span class="material-symbols-outlined">search</span>
            Yeni Kargo Sorgula
        </button>
    </div>
</div>
<div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
    <!-- Left Column (Main Info) -->
    <div class="lg:col-span-8 flex flex-col gap-6">
        <!-- Main Tracking Card -->
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6 flex flex-col md:flex-row gap-8">
            <!-- Basic Info -->
            <div class="flex-1 border-r-0 md:border-r border-outline-variant/30 pr-0 md:pr-6">
                <div class="mb-6">
                    <p class="font-label-caps text-label-caps text-outline mb-1 uppercase">Takip Numarası</p>
                    <h2 class="font-headline-md text-headline-md text-primary-container">@Model.TrackCode</h2>
                </div>
                <div class="inline-flex items-center gap-1.5 bg-surface-container-high text-primary-container px-3 py-1 rounded-full font-status-label text-status-label mb-6">
                    <span class="material-symbols-outlined text-[16px]">local_shipping</span>
                    @Model.CargoStatus
                </div>
                <div class="flex gap-8">
                    <div>
                        <p class="text-sm text-outline mb-1">Gönderim Tarihi</p>
                        <p class="font-semibold text-on-background">@Model.ShipmentDate</p>
                    </div>
                    <div>
                        <p class="text-sm text-outline mb-1">Tahmini Varış</p>
                        <p class="font-semibold text-on-background">@Model.EstimatedArrivalDate</p>
                    </div>
                </div>
            </div>
            <!-- Journey Graphic -->
            <div class="flex-1 flex flex-col justify-center">
                <div class="flex justify-between items-center mb-2">
                    <div class="flex flex-col items-center">
                        <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center mb-2 text-primary-container">
                            <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' 1;">location_on</span>
                        </div>
                        <span class="font-semibold text-on-background">@Model.OriginBranch.City.Name</span>
                        <span class="text-xs text-outline">@Model.OriginBranch.Name</span>
                    </div>
                    <div class="flex-grow flex items-center px-2">
                        <div class="w-2 h-2 rounded-full bg-outline-variant"></div>
                        <div class="flex-grow h-px bg-outline-variant relative">
                            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-surface-container-lowest px-2">
                                <span class="material-symbols-outlined text-secondary-container" style="font-variation-settings: 'FILL' 1;">local_shipping</span>
                            </div>
                        </div>
                        <div class="w-2 h-2 rounded-full bg-outline-variant"></div>
                    </div>
                    <div class="flex flex-col items-center">
                        <div class="w-8 h-8 rounded-full bg-surface-container text-outline flex items-center justify-center mb-2">
                            <span class="material-symbols-outlined text-[18px]">flag</span>
                        </div>
                        <span class="font-semibold text-on-background">@Model.DestinationBranch.City.Name</span>
                        <span class="text-xs text-outline">@Model.DestinationBranch.Name</span>
                    </div>
                </div>
            </div>
        </div>
        <!-- Sender / Receiver Cards -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant">
                    <span class="material-symbols-outlined">person</span>
                </div>
                <div>
                    <p class="font-label-caps text-label-caps text-outline mb-1 uppercase">Gönderici</p>
                    <p class="font-semibold text-on-background">@Model.Sender.FirstName @Model.Sender.LastName</p>
                    <p class="text-sm text-on-surface-variant">@Model.OriginBranch.City.Name / @Model.OriginBranch.Name</p>
                </div>
            </div>
            <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-5 flex items-center gap-4">
                <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-on-surface-variant">
                    <span class="material-symbols-outlined">person</span>
                </div>
                <div>
                    <p class="font-label-caps text-label-caps text-outline mb-1 uppercase">Alıcı</p>
                    <p class="font-semibold text-on-background">@Model.Receiver.FirstName @Model.Receiver.LastName</p>
                    <p class="text-sm text-on-surface-variant">@Model.DestinationBranch.City.Name / @Model.DestinationBranch.Name</p>
                </div>
            </div>
        </div>
        <!-- Package Details -->
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6">
            <h3 class="font-headline-md text-xl text-primary-container mb-4">Kargo Bilgileri</h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-surface rounded-lg p-4">
                    <p class="text-sm text-outline mb-1">Ağırlık</p>
                    <p class="font-semibold text-on-background">@Model.Weight kg</p>
                </div>
                <div class="bg-surface rounded-lg p-4">
                    <p class="text-sm text-outline mb-1">Gönderi Tipi</p>
                    <p class="font-semibold text-on-background">@Model.CargoType</p>
                </div>
                <div class="bg-surface rounded-lg p-4">
                    <p class="text-sm text-outline mb-1">Çıkış Şubesi</p>
                    <p class="font-semibold text-on-background">@Model.OriginBranch.Name</p>
                </div>
                <div class="bg-surface rounded-lg p-4">
                    <p class="text-sm text-outline mb-1">Varış Şubesi</p>
                    <p class="font-semibold text-on-background">@Model.DestinationBranch.Name</p>
                </div>
            </div>
        </div>
        <!-- Estimated Delivery Banner -->
        <div class="bg-primary-container rounded-xl shadow-sm p-6 text-on-primary">
            <div class="flex items-center gap-3 mb-2">
                <span class="material-symbols-outlined text-[28px]">schedule</span>
                <h3 class="font-headline-md text-2xl font-bold">Tahmini Teslimat: Bugün</h3>
            </div>
            <p class="text-primary-fixed-dim mb-6 ml-10">Planlanan Saat Aralığı: 14:00 - 18:00</p>
            <div class="relative w-full h-3 progress-bar-bg rounded-full overflow-hidden mb-2">
                <div class="absolute top-0 left-0 h-full progress-bar-fill rounded-full" style="width: 80%;"></div>
            </div>
            <div class="flex justify-between text-xs text-primary-fixed-dim">
                <span>Gönderi Kabul</span>
                <span>Teslimat</span>
            </div>
        </div>
    </div>
    <!-- Right Column (Timeline) -->
    <div class="lg:col-span-4">
        <div class="bg-surface-container-lowest rounded-xl shadow-sm border border-outline-variant/30 p-6 h-full">
            <div class="flex items-center gap-2 mb-6 pb-4 border-b border-outline-variant/30">
                <span class="material-symbols-outlined text-primary-container">history</span>
                <h3 class="font-headline-md text-xl text-primary-container">Kargo Hareketleri</h3>
            </div>
            <div class="relative">
                <!-- Timeline Items -->
                <div class="timeline-item relative pb-8 pl-10">
                    <div class="timeline-line"></div>
                    <div class="absolute left-0 top-0 w-6 h-6 rounded-full bg-green-500 text-white flex items-center justify-center z-10 ring-4 ring-white">
                        <span class="material-symbols-outlined text-[14px] font-bold">check</span>
                    </div>
                    <p class="font-semibold text-on-background mb-1">Gönderi Teslim Alındı</p>
                    <div class="flex items-center gap-1 text-sm text-outline">
                        <span class="material-symbols-outlined text-[16px]">location_on</span>
                        Ataşehir • 18 Ağu, 09:42
                    </div>
                </div>
                <div class="timeline-item relative pb-8 pl-10">
                    <div class="timeline-line"></div>
                    <div class="absolute left-0 top-0 w-6 h-6 rounded-full bg-green-500 text-white flex items-center justify-center z-10 ring-4 ring-white">
                        <span class="material-symbols-outlined text-[14px] font-bold">check</span>
                    </div>
                    <p class="font-semibold text-on-background mb-1">Transfer Merkezine Gönderildi</p>
                    <div class="flex items-center gap-1 text-sm text-outline">
                        <span class="material-symbols-outlined text-[16px]">location_on</span>
                        İstanbul Anadolu • 18 Ağu, 12:15
                    </div>
                </div>
                <div class="timeline-item relative pb-8 pl-10">
                    <div class="timeline-line"></div>
                    <div class="absolute left-0 top-0 w-6 h-6 rounded-full bg-green-500 text-white flex items-center justify-center z-10 ring-4 ring-white">
                        <span class="material-symbols-outlined text-[14px] font-bold">check</span>
                    </div>
                    <p class="font-semibold text-on-background mb-1">Transfer Merkezinden Çıktı</p>
                    <div class="flex items-center gap-1 text-sm text-outline">
                        <span class="material-symbols-outlined text-[16px]">location_on</span>
                        Ankara • 19 Ağu, 05:30
                    </div>
                </div>
                <div class="timeline-item relative pb-8 pl-10">
                    <div class="timeline-line"></div>
                    <div class="absolute left-0 top-0 w-6 h-6 rounded-full bg-green-500 text-white flex items-center justify-center z-10 ring-4 ring-white">
                        <span class="material-symbols-outlined text-[14px] font-bold">check</span>
                    </div>
                    <p class="font-semibold text-on-background mb-1">Dağıtım Şubesine Ulaştı</p>
                    <div class="flex items-center gap-1 text-sm text-outline">
                        <span class="material-symbols-outlined text-[16px]">location_on</span>
                        Çankaya • 19 Ağu, 08:45
                    </div>
                </div>
                <div class="timeline-item relative pb-8 pl-10">
                    <div class="timeline-line"></div>
                    <div class="absolute left-0 top-0 w-6 h-6 rounded-full bg-secondary-container text-white flex items-center justify-center z-10 ring-4 ring-white">
                        <span class="material-symbols-outlined text-[14px]">local_shipping</span>
                    </div>
                    <p class="font-semibold text-secondary-container mb-1">Dağıtıma Çıktı</p>
                    <div class="flex items-center gap-1 text-sm text-outline">
                        <span class="material-symbols-outlined text-[16px]">location_on</span>
                        Çankaya • 20 Ağu, 09:10
                    </div>
                </div>
                <div class="timeline-item relative pl-10">
                    <div class="absolute left-0 top-1 w-6 h-6 rounded-full border-2 border-outline-variant bg-white flex items-center justify-center z-10">
                    </div>
                    <p class="font-semibold text-outline mb-1">Teslim Edildi</p>
                </div>
            </div>
        </div>
    </div>
</div>

