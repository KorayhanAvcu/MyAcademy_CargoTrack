@{
    ViewData["Title"] = "Kargo Takip";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<div class="text-center mb-stack-lg">
    <h1 class="font-headline-xl text-headline-xl text-on-background mb-4">Kargo Takip</h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant">Takip numaranızı girerek gönderinizin güncel durumunu görüntüleyebilirsiniz.</p>
</div>

<div class="bg-white rounded-lg shadow-sm border border-outline-variant p-6 md:p-8 max-w-3xl mx-auto mb-section-padding relative overflow-hidden">
    <div class="absolute -right-16 -top-16 opacity-5 pointer-events-none">
        <span class="material-symbols-outlined text-[200px] text-primary">local_shipping</span>
    </div>
    <div class="flex items-center gap-3 mb-6 relative z-10">
        <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-primary">
            <span class="material-symbols-outlined">inventory_2</span>
        </div>
        <h2 class="font-headline-md text-headline-md text-on-background">Kargo Takip Numarası</h2>
    </div>

    <form asp-controller="Default" asp-action="CargoDetails" method="get" class="flex flex-col md:flex-row gap-4 relative z-10">
        <input name="trackCode" type="text" required autocomplete="off"
               class="flex-grow border border-outline-variant rounded-DEFAULT px-4 py-3 font-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow bg-surface-bright placeholder:text-outline h-[48px] uppercase"
               placeholder="Örn: MYC-2026-849251" />
        <button type="submit"
                class="bg-secondary-container text-on-primary px-8 py-3 rounded-DEFAULT font-semibold flex items-center justify-center gap-2 hover:bg-opacity-90 transition-opacity h-[48px] whitespace-nowrap shadow-sm hover:shadow-md">
            <span class="material-symbols-outlined text-sm font-bold">search</span>
            Gönderiyi Sorgula
        </button>
    </form>

    @if (ViewBag.Error != null)
    {
        <div class="mt-4 flex items-center gap-2 bg-error-container text-on-error-container px-4 py-3 rounded-lg relative z-10">
            <span class="material-symbols-outlined text-[20px]">error</span>
            <span>@ViewBag.Error</span>
        </div>
    }
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
    <div class="bg-surface-container-low rounded-xl p-6 relative overflow-hidden flex flex-col border border-surface-container shadow-sm">
        <div class="absolute -right-4 -top-4 opacity-10 pointer-events-none">
            <span class="material-symbols-outlined text-[120px]">help</span>
        </div>
        <div class="w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center text-primary-container mb-4 relative z-10 shadow-sm">
            <span class="material-symbols-outlined text-lg">lightbulb</span>
        </div>
        <h3 class="font-headline-md text-xl text-on-background mb-3 relative z-10">Takip numaramı nereden bulabilirim?</h3>
        <p class="text-on-surface-variant relative z-10">
            Gönderiniz oluşturulduğunda size iletilen <strong class="text-on-background font-semibold">MYC-2026-XXXXXX</strong> formatındaki kodu kullanabilirsiniz.
        </p>
    </div>

    <div class="bg-surface-container-low rounded-xl p-6 relative overflow-hidden flex flex-col border border-surface-container shadow-sm">
        <div class="absolute -right-4 -top-4 opacity-10 pointer-events-none">
            <span class="material-symbols-outlined text-[120px]">lock</span>
        </div>
        <div class="w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center text-primary-container mb-4 relative z-10 shadow-sm">
            <span class="material-symbols-outlined text-lg">shield_person</span>
        </div>
        <h3 class="font-headline-md text-xl text-on-background mb-3 relative z-10">Kişisel verileriniz güvende</h3>
        <p class="text-on-surface-variant relative z-10">
            Giriş yapmadan yapılan sorgularda isimler maskelenir. Tüm detaylar için hesabınıza giriş yapın.
        </p>
    </div>

    <div class="bg-surface-container-low rounded-xl p-6 relative overflow-hidden flex flex-col border border-surface-container shadow-sm">
        <div class="absolute -right-4 -top-4 opacity-10 pointer-events-none">
            <span class="material-symbols-outlined text-[120px]">key</span>
        </div>
        <div class="w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center text-primary-container mb-4 relative z-10 shadow-sm">
            <span class="material-symbols-outlined text-lg">pin</span>
        </div>
        <h3 class="font-headline-md text-xl text-on-background mb-3 relative z-10">Teslimat kodu</h3>
        <p class="text-on-surface-variant relative z-10">
            Kargonuz dağıtıma çıktığında 6 haneli teslimat kodunuz hesabınızda görünür. Kurye teslimatta bu kodu ister.
        </p>
        <a href="/Login/Index" class="text-primary font-bold text-sm flex items-center gap-1 hover:underline relative z-10 mt-4">
            Giriş Yap <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
    </div>
</div>
