
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}

<!-- Header Section -->
<div class="text-center mb-stack-lg">
    <h1 class="font-headline-xl text-headline-xl text-on-background mb-4">Kargo Takip</h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant">Takip numaranızı girerek gönderinizin güncel durumunu görüntüleyebilirsiniz.</p>
</div>
<!-- Search Card -->
<div class="bg-white rounded-lg shadow-sm border border-outline-variant p-6 md:p-8 max-w-3xl mx-auto mb-section-padding relative overflow-hidden">
    <div class="absolute -right-16 -top-16 opacity-5 pointer-events-none">
        <span class="material-symbols-outlined text-[200px] text-primary">local_shipping</span>
    </div>
    <div class="flex items-center gap-3 mb-6 relative z-10">
        <div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center text-primary">
            <span class="material-symbols-outlined">inventory_2</span>
        </div>
        <h2 class="font-headline-md text-headline-md text-on-background">Kargo Takip Numarası</h2>
    </div>
    <form class="flex flex-col md:flex-row gap-4 relative z-10" asp-action="CargoDetails" asp-controller="Default">
        <input name="trackCode" class="flex-grow border border-outline-variant rounded-DEFAULT px-4 py-3 font-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-shadow bg-surface-bright placeholder:text-outline h-[48px]" placeholder="Örn: CGT2026001458" type="text" />
        <button class="bg-secondary-container text-on-primary px-8 py-3 rounded-DEFAULT font-semibold flex items-center justify-center gap-2 hover:bg-opacity-90 transition-opacity h-[48px] whitespace-nowrap shadow-sm hover:shadow-md" type="submit">
            <span class="material-symbols-outlined text-sm font-bold">search</span>
            Gönderiyi Sorgula
        </button>
    </form>
    @if (ViewBag.error != null)
    {
        <div><strong>@ViewBag.error</strong></div>
    }



</div>
<!-- Recent Tracking & Help Section Grid -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
    <!-- Left Column: Recent Shipments -->
    <div class="lg:col-span-8">
        <h3 class="font-headline-md text-headline-md text-on-background mb-stack-md">Son Sorgulanan Gönderiler</h3>
        <div class="flex flex-col gap-4">
            <!-- Item 1: In Transit -->
            <div class="bg-white rounded-lg border border-outline-variant p-5 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 hover:shadow-sm transition-shadow group cursor-pointer border-l-4 border-l-surface-tint">
                <div>
                    <div class="flex items-center gap-3 mb-2">
                        <span class="font-body-md text-body-md font-bold text-on-background">CGT2026001458</span>
                        <span class="bg-surface-container-high text-primary-container px-2 py-1 rounded-full font-status-label text-status-label flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">local_shipping</span>
                            Dağıtıma Çıktı
                        </span>
                    </div>
                    <div class="flex items-center gap-2 text-on-surface-variant font-body-md text-body-md">
                        <span>İstanbul</span>
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                        <span>Ankara</span>
                    </div>
                </div>
                <div class="text-right md:text-right text-left w-full md:w-auto mt-2 md:mt-0 pt-4 md:pt-0 border-t border-outline-variant md:border-none">
                    <div class="text-on-surface-variant text-sm mb-1">Tahmini Teslimat</div>
                    <div class="flex items-center md:justify-end gap-1 font-body-md text-body-md font-bold text-on-background">
                        <span class="material-symbols-outlined text-sm">calendar_month</span>
                        20 Ağustos 2026
                    </div>
                </div>
            </div>
            <!-- Item 2: Transfer -->
            <div class="bg-white rounded-lg border border-outline-variant p-5 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 hover:shadow-sm transition-shadow group cursor-pointer border-l-4 border-l-secondary-container">
                <div>
                    <div class="flex items-center gap-3 mb-2">
                        <span class="font-body-md text-body-md font-bold text-on-background">CGT2026001287</span>
                        <span class="bg-[#fff3e0] text-[#e65100] px-2 py-1 rounded-full font-status-label text-status-label flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">swap_horiz</span>
                            Transfer Merkezinde
                        </span>
                    </div>
                    <div class="flex items-center gap-2 text-on-surface-variant font-body-md text-body-md">
                        <span>İzmir</span>
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                        <span>Bursa</span>
                    </div>
                </div>
                <div class="text-right md:text-right text-left w-full md:w-auto mt-2 md:mt-0 pt-4 md:pt-0 border-t border-outline-variant md:border-none">
                    <div class="text-on-surface-variant text-sm mb-1">Son İşlem Tarihi</div>
                    <div class="flex items-center md:justify-end gap-1 font-body-md text-body-md font-bold text-on-background">
                        <span class="material-symbols-outlined text-sm">schedule</span>
                        18 Ağustos 2026
                    </div>
                </div>
            </div>
            <!-- Item 3: Delivered -->
            <div class="bg-white rounded-lg border border-outline-variant p-5 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 hover:shadow-sm transition-shadow group cursor-pointer border-l-4 border-l-[#4caf50]">
                <div>
                    <div class="flex items-center gap-3 mb-2">
                        <span class="font-body-md text-body-md font-bold text-on-background">CGT2026000974</span>
                        <span class="bg-[#e8f5e9] text-[#2e7d32] px-2 py-1 rounded-full font-status-label text-status-label flex items-center gap-1">
                            <span class="material-symbols-outlined text-[14px]">check_circle</span>
                            Teslim Edildi
                        </span>
                    </div>
                    <div class="flex items-center gap-2 text-on-surface-variant font-body-md text-body-md">
                        <span>Antalya</span>
                        <span class="material-symbols-outlined text-sm">arrow_forward</span>
                        <span>İstanbul</span>
                    </div>
                </div>
                <div class="text-right md:text-right text-left w-full md:w-auto mt-2 md:mt-0 pt-4 md:pt-0 border-t border-outline-variant md:border-none">
                    <div class="text-on-surface-variant text-sm mb-1">Teslim Tarihi</div>
                    <div class="flex items-center md:justify-end gap-1 font-body-md text-body-md font-bold text-[#2e7d32]">
                        <span class="material-symbols-outlined text-sm">done_all</span>
                        15 Ağustos 2026
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Right Column: Help Card -->
    <div class="lg:col-span-4 mt-stack-lg lg:mt-0 lg:pt-14">
        <div class="bg-surface-container-low rounded-xl p-6 relative overflow-hidden h-full flex flex-col border border-surface-container shadow-sm">
            <!-- Decorative large icon -->
            <div class="absolute -right-4 -top-4 opacity-10 pointer-events-none">
                <span class="material-symbols-outlined text-[120px]">help</span>
            </div>
            <div class="w-10 h-10 rounded-full bg-primary-fixed flex items-center justify-center text-primary-container mb-4 relative z-10 shadow-sm">
                <span class="material-symbols-outlined text-lg">lightbulb</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-on-background mb-3 relative z-10">Takip numaramı nereden bulabilirim?</h3>
            <p class="font-body-md text-body-md text-on-surface-variant mb-6 relative z-10 flex-grow">
                Gönderi oluşturulduğunda size SMS veya e-posta ile iletilen <strong class="text-on-background font-semibold">13 haneli alfabetik ve sayısal karakterlerden</strong> oluşan kodu kullanabilirsiniz.
            </p>
            <a class="text-primary font-bold text-sm flex items-center gap-1 hover:underline relative z-10 mt-auto" href="#">
                Destek Merkezi'ne Git
                <span class="material-symbols-outlined text-sm">open_in_new</span>
            </a>
        </div>
    </div>
</div>