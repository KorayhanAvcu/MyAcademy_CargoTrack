@model UpdateBranchDto
@{
    ViewData["Title"] = "Update";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Şube Güncelleme</h1>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <label>Şube İsmi</label>
    <input type="text" asp-for="Name" class="form-control" />
    <span class="text-danger" asp-validation-for="Name"></span>
    <br />
    <label>Şehir</label>
    <select asp-for="CityId" class="form-control" asp-items="ViewBag.Cities">
        <option disabled selected value="">Şehir Seçiniz</option>
    </select>
    <br />
    <button class="btn btn-dark">Güncelle</button>

</form>