@model UpdateCargoPriceDto
@{ ViewData["Title"] = "Fiyat Kuralı Güncelle"; }
<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-6">
    <div>
        <h2 class="page-title">Fiyat Kuralı Güncelle</h2>
    </div>
</div>
<form method="post" class="card max-w-xl">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All"></div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div>
            <label class="label">Teslimat Tipi</label>
            <select asp-for="DeliveryType" asp-items="Html.GetEnumSelectList<DeliveryType>()" class="input"></select>
        </div>
        <div>
            <label class="label">Mesafe</label>
            <select asp-for="DistanceType" asp-items="Html.GetEnumSelectList<DistanceType>()" class="input"></select>
        </div>
    </div>
    <div class="grid grid-cols-3 gap-4 mb-6">
        <div><label class="label">Min Desi</label><input asp-for="MinDesi" class="input" /></div>
        <div><label class="label">Max Desi</label><input asp-for="MaxDesi" class="input" /></div>
        <div><label class="label">Ücret (₺)</label><input asp-for="Price" class="input" /></div>
    </div>
    <div class="flex gap-2">
        <a asp-action="Index" class="btn-outline">Vazgeç</a>
        <button class="btn-accent">Kaydet</button>
    </div>
</form>
