@model List<RoleAssignDto>
@{ ViewData["Title"] = "Rol Ata"; }
<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-6">
    <div>
        <h2 class="page-title">Rol Ata</h2>
        <p class="text-on-surface-variant">@ViewBag.fullName kullanıcısının rollerini seçin</p>
    </div>
</div>
<form method="post" class="card max-w-md">
    <div class="flex flex-col gap-3 mb-6">
        @for (int i = 0; i < Model.Count; i++)
        {
            <label class="flex items-center gap-3 p-3 rounded-lg border border-outline-variant hover:bg-surface-container-low cursor-pointer">
                <input type="checkbox" asp-for="@Model[i].RoleExist" class="rounded w-5 h-5 text-primary-container" />
                <span class="font-semibold">@Model[i].RoleName</span>
            </label>
            <input type="hidden" asp-for="@Model[i].RoleName" />
            <input type="hidden" asp-for="@Model[i].RoleId" />
            <input type="hidden" asp-for="@Model[i].UserId" />
        }
    </div>
    <p class="text-xs text-outline mb-4">Manager rolü verdiğiniz kullanıcıyı ardından Personel ekranından bir şubeye bağlayın.</p>
    <div class="flex gap-2">
        <a asp-action="Index" class="btn-outline">Vazgeç</a>
        <button class="btn-accent">Kaydet</button>
    </div>
</form>
