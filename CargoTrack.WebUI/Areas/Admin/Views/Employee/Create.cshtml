@model CreateEmployeeDto
@{ ViewData["Title"] = "Yeni Personel"; }
<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-6">
    <div>
        <h2 class="page-title">Yeni Personel</h2>
        <p class="text-on-surface-variant">Sadece Manager rolündeki kullanıcılar listelenir</p>
    </div>
</div>
<form method="post" class="card max-w-md">
    <div asp-validation-summary="All"></div>
    <div class="mb-4">
        <label class="label">Kullanıcı</label>
        <select asp-for="AppUserId" asp-items="(List<SelectListItem>)ViewBag.Users" class="input">
            <option value="">Seçiniz</option>
        </select>
    </div>
    <div class="mb-4">
        <label class="label">Şube</label>
        <select asp-for="BranchId" asp-items="(List<SelectListItem>)ViewBag.Branches" class="input">
            <option value="">Seçiniz</option>
        </select>
    </div>
    <div class="mb-6">
        <label class="label">Pozisyon</label>
        <input asp-for="Position" class="input" placeholder="Şube Müdürü, Kurye..." />
    </div>
    <div class="flex gap-2">
        <a asp-action="Index" class="btn-outline">Vazgeç</a>
        <button class="btn-accent">Kaydet</button>
    </div>
</form>
