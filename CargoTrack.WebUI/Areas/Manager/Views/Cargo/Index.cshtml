@model PagedResultDto<ResultCargoDto>
@{ ViewData["Title"] = "Şube Kargoları"; }
<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-6">
    <div>
        <h2 class="page-title">Şube Kargoları</h2>
        <p class="text-on-surface-variant">Şubenizden çıkan ve şubenize gelen tüm gönderiler</p>
    </div>
</div>
<vc:cargo-filter filter="(CargoFilterDto)ViewBag.Filter" show-direction="false" />
<vc:cargo-table cargos="Model.Items" />
<vc:pagination pagination="Model.ToPagination()" />
