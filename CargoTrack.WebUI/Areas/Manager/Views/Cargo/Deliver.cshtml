@model DeliverCargoDto
@{ ViewData["Title"] = "Teslimat"; }
<div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-4 mb-6">
    <div>
        <h2 class="page-title">Teslimat Kodu Doğrulama</h2>
        <p class="text-on-surface-variant">Alıcının söylediği 6 haneli kodu girin</p>
    </div>
</div>
<form method="post" class="card max-w-md">
    <input type="hidden" asp-for="CargoId" />
    <div asp-validation-summary="All"></div>
    <div class="mb-4">
        <label class="label">Teslimat Kodu</label>
        <input asp-for="DeliveryCode" class="input text-center text-3xl font-bold tracking-[0.4em] py-3" maxlength="6" autocomplete="off" placeholder="______" />
    </div>
    <div class="mb-6">
        <label class="label">Teslim Alan Kişi</label>
        <input asp-for="ReceivedByName" class="input" />
    </div>
    <div class="flex gap-2">
        <a asp-action="Detail" asp-route-id="@Model.CargoId" class="btn-outline">Vazgeç</a>
        <button class="btn bg-[#2e7d32] text-white hover:opacity-90"><span class="material-symbols-outlined text-[18px]">task_alt</span> Teslim Et</button>
    </div>
</form>
